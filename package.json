{
  "name": "sdd-platform",
  "displayName": "SDD Platform",
  "description": "Spec-Driven Development for VS Code — AI-assisted structured development workflow",
  "version": "0.0.1",
  "publisher": "andrelmm91",
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "resources/icon.png",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.sdd/config.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sdd.initProject",
        "title": "SDD: Initialize Project"
      },
      {
        "command": "sdd.newSpec",
        "title": "SDD: New Spec"
      },
      {
        "command": "sdd.refreshSpecs",
        "title": "SDD: Refresh Specs",
        "icon": "$(refresh)"
      },
      {
        "command": "sdd.markReady",
        "title": "SDD: Mark Ready"
      },
      {
        "command": "sdd.validateSpec",
        "title": "SDD: Validate Spec"
      },
      {
        "command": "sdd.executeSpec",
        "title": "SDD: Execute Spec"
      },
      {
        "command": "sdd.reviewSpec",
        "title": "SDD: Review Spec"
      },
      {
        "command": "sdd.approveSpec",
        "title": "SDD: Approve Spec"
      },
      {
        "command": "sdd.requestChanges",
        "title": "SDD: Request Changes"
      },
      {
        "command": "sdd.rejectSpec",
        "title": "SDD: Reject Spec"
      },
      {
        "command": "sdd.openDashboard",
        "title": "SDD: Open Dashboard"
      },
      {
        "command": "sdd.planFromRequirements",
        "title": "SDD: Plan Specs from Requirements"
      },
      {
        "command": "sdd.refinePlan",
        "title": "SDD: Refine Plan"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sdd.refreshSpecs",
          "when": "view == sdd.specsTree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "sdd.markReady",
          "when": "view == sdd.specsTree && viewItem == 'draft'",
          "group": "sdd@1"
        },
        {
          "command": "sdd.validateSpec",
          "when": "view == sdd.specsTree && (viewItem == 'draft' || viewItem == 'ready')",
          "group": "sdd@2"
        },
        {
          "command": "sdd.executeSpec",
          "when": "view == sdd.specsTree && viewItem == 'ready'",
          "group": "sdd@1"
        },
        {
          "command": "sdd.reviewSpec",
          "when": "view == sdd.specsTree && (viewItem == 'in_progress' || viewItem == 'review')",
          "group": "sdd@1"
        },
        {
          "command": "sdd.approveSpec",
          "when": "view == sdd.specsTree && viewItem == 'review'",
          "group": "sdd@2"
        },
        {
          "command": "sdd.requestChanges",
          "when": "view == sdd.specsTree && viewItem == 'review'",
          "group": "sdd@3"
        },
        {
          "command": "sdd.rejectSpec",
          "when": "view == sdd.specsTree && viewItem == 'review'",
          "group": "sdd@4"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sdd-sidebar",
          "title": "SDD Platform",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "sdd-sidebar": [
        {
          "id": "sdd.specsTree",
          "name": "Specs",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "SDD Platform",
      "properties": {
        "sdd.specPrefix": {
          "type": "string",
          "default": "SDD",
          "description": "Prefix used for spec IDs (e.g. SDD → SDD-001)"
        },
        "sdd.conventionsPath": {
          "type": "string",
          "default": ".sdd/conventions.md",
          "description": "Path to the project conventions file"
        },
        "sdd.testCommand": {
          "type": "string",
          "default": "",
          "description": "Command used to run tests (e.g. npm test). Falls back to project config when empty."
        },
        "sdd.claudeCliBinary": {
          "type": "string",
          "default": "claude",
          "description": "Path or name of the Claude CLI binary to use for spec execution"
        },
        "sdd.defaultBudget": {
          "type": "number",
          "default": 100000,
          "description": "Default token budget for spec execution"
        },
        "sdd.autoValidate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run post-execution validation after a spec is executed"
        }
      }
    },
    "languages": [
      {
        "id": "sdd-spec",
        "aliases": [
          "SDD Spec",
          "sdd"
        ],
        "extensions": [
          ".sdd.md"
        ],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:webview": "vite build --config webview-ui/vite.config.ts",
    "dev": "node esbuild.config.mjs --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^20.19.35",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "svelte": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "yaml": "^2.8.2"
  }
}
