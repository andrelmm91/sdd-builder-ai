{
  "name": "sdd-platform",
  "displayName": "Builder AI",
  "description": "Spec-Driven Development for VS Code \u2014 AI-assisted structured development workflow",
  "version": "0.1.0",
  "publisher": "andrelmm91",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrelmm91/sdd-agentic"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "media/logo.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "keywords": [
    "sdd",
    "spec-driven",
    "ai",
    "claude",
    "code-generation",
    "specs"
  ],
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.sdd/config.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sdd.initProject",
        "title": "SDD: Initialize Project"
      },
      {
        "command": "sdd.newSpec",
        "title": "SDD: New Spec"
      },
      {
        "command": "sdd.refreshSpecs",
        "title": "SDD: Refresh Specs",
        "icon": "$(refresh)"
      },
      {
        "command": "sdd.markReady",
        "title": "SDD: Mark Ready"
      },
      {
        "command": "sdd.validateSpec",
        "title": "SDD: Validate Spec"
      },
      {
        "command": "sdd.executeSpec",
        "title": "SDD: Execute Spec"
      },
      {
        "command": "sdd.reviewSpec",
        "title": "SDD: Review Spec"
      },
      {
        "command": "sdd.approveSpec",
        "title": "SDD: Approve Spec"
      },
      {
        "command": "sdd.requestChanges",
        "title": "SDD: Request Changes"
      },
      {
        "command": "sdd.rejectSpec",
        "title": "SDD: Reject Spec"
      },
      {
        "command": "sdd.openDashboard",
        "title": "SDD: Open Dashboard"
      },
      {
        "command": "sdd.openKanbanBoard",
        "title": "SDD: Open Kanban Board"
      },
      {
        "command": "sdd.addToBulk",
        "title": "SDD: Add to Bulk Queue"
      },
      {
        "command": "sdd.executeAllBulk",
        "title": "SDD: Execute All Bulk"
      },
      {
        "command": "sdd.idealizeRequirements",
        "title": "SDD: Idealize Requirements"
      },
      {
        "command": "sdd.createSddCards",
        "title": "SDD: Create SDD Cards"
      },
      {
        "command": "sdd.openRequirementBoard",
        "title": "SDD: Open Requirement Board"
      },
      {
        "command": "sdd.newSpecForm",
        "title": "SDD: New Spec (Form)"
      },
      {
        "command": "sdd.openAiConfig",
        "title": "SDD: Open AI Configuration"
      },
      {
        "command": "sdd.planFromRequirements",
        "title": "SDD: Plan Specs from Requirements"
      },
      {
        "command": "sdd.refinePlan",
        "title": "SDD: Refine Plan"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sdd.refreshSpecs",
          "when": "view == sdd.specsTree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "sdd.markReady",
          "when": "view == sdd.specsTree && viewItem == 'draft'",
          "group": "sdd@1"
        },
        {
          "command": "sdd.validateSpec",
          "when": "view == sdd.specsTree && (viewItem == 'draft' || viewItem == 'ready')",
          "group": "sdd@2"
        },
        {
          "command": "sdd.executeSpec",
          "when": "view == sdd.specsTree && viewItem == 'ready'",
          "group": "sdd@1"
        },
        {
          "command": "sdd.reviewSpec",
          "when": "view == sdd.specsTree && (viewItem == 'in_progress' || viewItem == 'review')",
          "group": "sdd@1"
        },
        {
          "command": "sdd.approveSpec",
          "when": "view == sdd.specsTree && viewItem == 'review'",
          "group": "sdd@2"
        },
        {
          "command": "sdd.requestChanges",
          "when": "view == sdd.specsTree && viewItem == 'review'",
          "group": "sdd@3"
        },
        {
          "command": "sdd.rejectSpec",
          "when": "view == sdd.specsTree && viewItem == 'review'",
          "group": "sdd@4"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sdd-sidebar",
          "title": "Builder AI",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "sdd-sidebar": [
        {
          "id": "sdd.specsTree",
          "name": "Specs",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "Builder AI",
      "properties": {
        "sdd.specPrefix": {
          "type": "string",
          "default": "SDD",
          "description": "Prefix used for spec IDs (e.g. SDD \u2192 SDD-001)"
        },
        "sdd.conventionsPath": {
          "type": "string",
          "default": ".sdd/conventions.md",
          "description": "Path to the project conventions file"
        },
        "sdd.testCommand": {
          "type": "string",
          "default": "",
          "description": "Command used to run tests (e.g. npm test). Falls back to project config when empty."
        },
        "sdd.claudeCliBinary": {
          "type": "string",
          "default": "claude",
          "description": "Path or name of the Claude CLI binary to use for spec execution"
        },
        "sdd.defaultBudget": {
          "type": "number",
          "default": 100000,
          "description": "Default token budget for spec execution"
        },
        "sdd.autoValidate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run post-execution validation after a spec is executed"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "sdd.gettingStarted",
        "title": "Getting Started with SDD",
        "description": "Learn the SDD workflow: initialize, create specs, execute with AI, and ship.",
        "steps": [
          {
            "id": "initProject",
            "title": "Initialize your project",
            "description": "Run **SDD: Initialize Project** to set up the `.sdd` folder structure with config, conventions, and skills.\n\n[Initialize Project](command:sdd.initProject)",
            "media": {
              "image": "media/logo.png",
              "altText": "Initialize project"
            },
            "completionEvents": [
              "onCommand:sdd.initProject"
            ]
          },
          {
            "id": "newSpec",
            "title": "Create your first spec",
            "description": "Run **SDD: New Spec** to create a `.sdd.md` spec file with all required sections.\n\n[New Spec](command:sdd.newSpec)",
            "media": {
              "image": "media/logo.png",
              "altText": "Create a spec"
            },
            "completionEvents": [
              "onCommand:sdd.newSpec"
            ]
          },
          {
            "id": "specFormat",
            "title": "Understand the spec format",
            "description": "Each `.sdd.md` file has YAML frontmatter (spec_id, status, priority, budget_max_tokens, \u2026) followed by markdown sections: **Context**, **Requirements**, **Acceptance Criteria**, **Constraints**, and **Examples**.\n\nOpen the Specs panel to browse your specs.",
            "media": {
              "image": "media/logo.png",
              "altText": "Spec format"
            },
            "completionEvents": [
              "onView:sdd.specsTree"
            ]
          },
          {
            "id": "markReady",
            "title": "Mark spec as ready",
            "description": "Edit your spec until it is complete, then right-click it in the Specs panel and run **SDD: Mark Ready** to transition it to `ready` status.\n\n[Mark Ready](command:sdd.markReady)",
            "media": {
              "image": "media/logo.png",
              "altText": "Mark spec ready"
            },
            "completionEvents": [
              "onCommand:sdd.markReady"
            ]
          },
          {
            "id": "executeSpec",
            "title": "Execute with AI",
            "description": "Right-click a `ready` spec and run **SDD: Execute Spec** to have Claude implement the spec within the defined token budget.\n\n[Execute Spec](command:sdd.executeSpec)",
            "media": {
              "image": "media/logo.png",
              "altText": "Execute spec"
            },
            "completionEvents": [
              "onCommand:sdd.executeSpec"
            ]
          },
          {
            "id": "reviewSpec",
            "title": "Review and ship",
            "description": "Review the AI's changes in the diff view, then **Approve** to create a PR or **Request Changes** to send feedback back to the agent.\n\n[Review Spec](command:sdd.reviewSpec)",
            "media": {
              "image": "media/logo.png",
              "altText": "Review and ship"
            },
            "completionEvents": [
              "onCommand:sdd.reviewSpec"
            ]
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "sdd-spec",
        "aliases": [
          "SDD Spec",
          "sdd"
        ],
        "extensions": [
          ".sdd.md"
        ],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:webview": "vite build --config webview-ui/vite.config.ts",
    "build:all": "npm run build && npm run build:webview",
    "dev": "node esbuild.config.mjs --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build:all && vsce package",
    "publish": "npm run build:all && vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^20.19.35",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "svelte": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "yaml": "^2.8.2"
  }
}
