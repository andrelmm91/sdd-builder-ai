{
  "name": "all-branches-protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "non_fast_forward"
    },
    {
      "type": "branch_name_pattern",
      "parameters": {
        "name": "Branch naming convention",
        "negate": false,
        "operator": "regex",
        "pattern": "^(main|feat|fix|docs|refactor|test|chore|release)[\\/\\-].+"
      }
    }
  ],
  "bypass_actors": []
}
